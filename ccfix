#!/usr/bin/env -S uv run --quiet python3
"""
ccfix - un-mangle text copied out of the Claude Code console.

CC renders its output hard-wrapped to the terminal width, indented, and (for
blockquotes) prefixed with a `▎` bar.  Selecting and copying it carries all of
that along.  ccfix reads the clipboard, undoes the rendering, and writes the
clean text back.

    ccfix              auto-detect prose vs command, fix the clipboard in place
    ccfix prose        force prose mode
    ccfix cmd          force command mode
    ccfix undo         restore the clipboard from before the last fix
    ccfix capture NAME save the clipboard as a new test case,
                       tests/ccfix/NAME.in.txt (write NAME.out.txt by hand)
    ccfix test         run the pytest suite (test_ccfix.py)

    --print            write the result to stdout instead of the clipboard
    --stdin            read from stdin instead of the clipboard
    --width N          the terminal width CC rendered at (or $CCFIX_WIDTH);
                       exact beats the inferred floor below

What it does:
  - strips the `▎` quote bar, CC's `⏺` bullet, and the common indent
  - joins lines CC wrapped, keeping real newlines (see `was_wrapped`)
  - prose: one paragraph per line, blank line between paragraphs, two spaces
    after a sentence-ending period when a wrap fell there
  - cmd: straightens curly quotes, never leaves a trailing newline (so a paste
    into a shell doesn't execute)

The wrap test: a renderer breaks before word W only when W would not fit, so
if `len(line) + 1 + len(W) <= width` the break was a real newline.  Without
--width the width is inferred as max(longest line, MIN_WIDTH): it is at least
the longest line, and CC never wraps narrower than MIN_WIDTH in a real
terminal.  The inferred case always treats the break after the widest line as
a wrap, so a paste of two separate 90-char commands joins wrongly - pass
--width for those.

For a whole CC response, `/copy` inside Claude Code is better - it copies the
raw markdown with no rendering at all.  ccfix is for a hand selection.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

MIN_WIDTH = 60
FIXTURES = Path(__file__).resolve().parent / "tests" / "ccfix"
CACHE = Path(os.environ.get("CCFIX_CACHE", Path.home() / ".cache" / "ccfix"))

QUOTE_RE = re.compile(r"^\s*▎ ?")
BULLET_RE = re.compile(r"^(\s*)⏺ ")
LIST_RE = re.compile(r"^\s*([-*•]|\d+[.)]|\$|#|>)\s")
SENTENCE_END_RE = re.compile(r"[.?!][\"')\]]*$")
CURLY = str.maketrans({"“": '"', "”": '"', "‘": "'", "’": "'", " ": " "})


def clean_lines(text: str) -> tuple[list[str], bool]:
    """Strip trailing space, NBSP, the ⏺ bullet, and the ▎ quote bar.

    Returns the lines and whether any quote bar was present.  Lengths for the
    wrap test are taken AFTER this, so the bar and bullet don't skew the width.
    """
    lines = [ln.replace(" ", " ").rstrip() for ln in text.replace("\r\n", "\n").split("\n")]
    quoted = any(QUOTE_RE.match(ln) for ln in lines if ln.strip())
    if quoted:
        lines = [QUOTE_RE.sub("", ln) if QUOTE_RE.match(ln) else ln.strip() for ln in lines]
    lines = [BULLET_RE.sub(r"\1  ", ln) for ln in lines]
    return dedent(lines), quoted


def dedent(lines: list[str]) -> list[str]:
    indents = [len(ln) - len(ln.lstrip(" ")) for ln in lines if ln.strip()]
    cut = min(indents, default=0)
    return [ln[cut:] for ln in lines]


def first_word(line: str) -> str:
    parts = line.split()
    return parts[0] if parts else ""


def was_wrapped(line: str, nxt: str, width: int) -> bool:
    """True if the break between `line` and `nxt` looks like a renderer wrap."""
    if not line.strip() or not nxt.strip():
        return False
    if line.endswith("\\"):
        return False
    if LIST_RE.match(nxt):
        return False
    return len(line) + 1 + len(first_word(nxt)) > width


def detect(lines: list[str], quoted: bool) -> str:
    if quoted:
        return "prose"
    body = [ln.strip() for ln in lines if ln.strip()]
    if any(ln.startswith("$ ") or ln.endswith("\\") for ln in body):
        return "cmd"
    if any(re.search(r"[A-Za-z][.?!:]$", ln) for ln in body):
        return "prose"
    return "cmd"


def join(prev: str, raw_prev: str, nxt: str, width: int, mode: str) -> str:
    nxt = nxt.lstrip()
    if len(raw_prev) == width and " " not in raw_prev.strip():
        # A single unbroken token filling the line was split mid-token (a long URL or path).
        return prev + nxt
    if mode == "prose" and SENTENCE_END_RE.search(prev):
        return prev + "  " + nxt
    return prev + " " + nxt


def fix(text: str, mode: str = "auto", width: int | None = None) -> str:
    lines, quoted = clean_lines(text)
    if mode == "auto":
        mode = detect(lines, quoted)
    if width is None:
        width = max(max((len(ln) for ln in lines), default=0), MIN_WIDTH)

    out: list[str] = []
    raw_prev = ""
    for ln in lines:
        if out and was_wrapped(raw_prev, ln, width):
            out[-1] = join(out[-1], raw_prev, ln, width, mode)
        else:
            out.append(ln)
        raw_prev = ln

    # Collapse runs of blank lines to one, drop leading/trailing blanks.
    result: list[str] = []
    for ln in out:
        if not ln.strip() and (not result or not result[-1].strip()):
            continue
        result.append(ln)
    while result and not result[-1].strip():
        result.pop()

    s = "\n".join(result)
    if mode == "cmd":
        s = s.translate(CURLY)
    return s


def pbpaste() -> str:
    return subprocess.run(["pbpaste"], capture_output=True, text=True, check=True).stdout


def pbcopy(s: str) -> None:
    subprocess.run(["pbcopy"], input=s, text=True, check=True)


def main(argv: list[str]) -> int:
    width = int(os.environ["CCFIX_WIDTH"]) if os.environ.get("CCFIX_WIDTH") else None
    if "--width" in argv:
        i = argv.index("--width")
        width = int(argv[i + 1])
        argv = argv[:i] + argv[i + 2:]
    args = [a for a in argv if not a.startswith("--")]
    flags = {a for a in argv if a.startswith("--")}
    cmd = args[0] if args else "auto"

    if cmd == "test":
        suite = Path(__file__).resolve().parent / "test_ccfix.py"
        return subprocess.call([str(suite), *args[1:]])
    if cmd == "capture":
        if len(args) != 2 or not re.fullmatch(r"[\w-]+", args[1]):
            print("usage: ccfix capture NAME   (letters, digits, - and _)", file=sys.stderr)
            return 2
        dest = FIXTURES / f"{args[1]}.in.txt"
        if dest.exists():
            print(f"ccfix: {dest} already exists", file=sys.stderr)
            return 1
        FIXTURES.mkdir(parents=True, exist_ok=True)
        dest.write_text(pbpaste())
        print(f"ccfix: saved {dest}\n  now write {dest.with_name(args[1] + '.out.txt')} by hand",
              file=sys.stderr)
        return 0
    if cmd == "undo":
        saved = CACHE / "last"
        if not saved.exists():
            print("ccfix: nothing to undo", file=sys.stderr)
            return 1
        pbcopy(saved.read_text())
        print("ccfix: clipboard restored", file=sys.stderr)
        return 0
    if cmd not in ("auto", "prose", "cmd") or flags - {"--print", "--stdin"}:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    src = sys.stdin.read() if "--stdin" in flags else pbpaste()
    out = fix(src, cmd, width)
    if "--print" in flags:
        sys.stdout.write(out + "\n")
        return 0
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "last").write_text(src)
    pbcopy(out)
    n_in, n_out = src.count("\n") + 1, out.count("\n") + 1
    print(f"ccfix: {n_in} → {n_out} lines (undo: ccfix undo)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
